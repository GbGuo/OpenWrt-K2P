USE_PROCD=1
START=99

ss_confdir=/var/etc/shadowsocks-libev
ss_bindir=/usr/bin
ss_easylog=/tmp/ss-easy.log

ss_log() {
	echo "$(date '+%F %T') $*" >>"$ss_easylog"
	logger -t ss-easy "$*"
}

ss_listening() {
	netstat -ln 2>/dev/null | grep -q ":$1" && return 0
	ss -ln 2>/dev/null | grep -q ":$1" && return 0
	return 1
}

ss_resolve4() {
	local host="$1" ip
	[ -n "$host" ] || return 1
	echo "$host" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' && { echo "$host"; return 0; }
	ip=$(resolveip -t 3 -4 "$host" 2>/dev/null | head -1)
	[ -n "$ip" ] || return 1
	echo "$ip"
}

ss_xray_bin() {
	if [ -x /tmp/xray-root/usr/bin/xray ]; then
		echo /tmp/xray-root/usr/bin/xray
		return 0
	fi
	if [ -x /usr/bin/xray ]; then
		echo /usr/bin/xray
		return 0
	fi
	return 1
}

ss_fetch_xray_bg() {
	ss_log "xray missing; fetch in background (DNS not hijacked)"
	if mkdir /tmp/xray-fetching 2>/dev/null; then
		( /usr/libexec/xray-ram-fetch.sh; rmdir /tmp/xray-fetching 2>/dev/null; /etc/init.d/shadowsocks-libev restart ) >>/tmp/xray-ram.log 2>&1 &
	fi
}

ss_method_libev_ok() {
	case "$1" in
		aes-128-gcm|aes-192-gcm|aes-256-gcm|chacha20-ietf-poly1305|xchacha20-ietf-poly1305|\
		aes-128-cfb|aes-192-cfb|aes-256-cfb|aes-128-ctr|aes-192-ctr|aes-256-ctr|\
		chacha20-ietf|chacha20|rc4-md5|table|bf-cfb|camellia-128-cfb|camellia-192-cfb|camellia-256-cfb|salsa20)
			return 0 ;;
	esac
	return 1
}

ssrules_uc="/usr/share/ss-rules/ss-rules.uc"
ssrules_nft="/etc/nftables.d/90-ss-rules.nft"

ss_mkjson_server_conf() {
	local cfgserver

	config_get cfgserver "$cfg" server
	[ -n "$cfgserver" ] || return 1
	eval "$(validate_server_section "$cfg" ss_validate_mklocal)"
	validate_server_section "$cfgserver" || return 1
	[ "$disabled" = 0 ] || return 1
	ss_mkjson_server_conf_ "$cfgserver"
}

ss_mkjson_server_conf_() {
	[ -n "$server_port" ] || return 1
	[ -z "$server" ] || json_add_string server "$server"
	json_add_int server_port "$server_port"
	[ -z "$method" ] || json_add_string method "$method"
	[ -z "$key" ] || json_add_string key "$key"
	[ -z "$password" ] || json_add_string password "$password"
	[ -z "$plugin" ] || json_add_string plugin "$plugin"
	[ -z "$plugin_opts" ] || json_add_string plugin_opts "$plugin_opts"
}

ss_mkjson_ss_local_conf() {
	ss_mkjson_server_conf
}

ss_mkjson_ss_redir_conf() {
	ss_mkjson_server_conf
}

ss_mkjson_ss_server_conf() {
	ss_mkjson_server_conf_
}

ss_mkjson_ss_tunnel_conf() {
	ss_mkjson_server_conf || return 1
	[ -n "$tunnel_address" ] || return 1
	json_add_string tunnel_address "$tunnel_address"
}

ss_xxx() {
	local cfg="$1"
	local cfgtype="$2"
	local bin="$ss_bindir/${cfgtype/_/-}"
	local confjson="$ss_confdir/$cfgtype.$cfg.json"

	[ -x "$bin" ] || { ss_log "skip $cfgtype.$cfg: no $bin"; return; }
	eval "$("validate_${cfgtype}_section" "$cfg" ss_validate_mklocal)"
	"validate_${cfgtype}_section" "$cfg" || { ss_log "validate fail $cfgtype.$cfg"; return; }
	[ "$disabled" = 0 ] || { ss_log "disabled $cfgtype.$cfg"; return; }

	json_init
	ss_mkjson_${cfgtype}_conf || { ss_log "json fail $cfgtype.$cfg server=$(uci -q get shadowsocks-libev.$cfg.server)"; return; }
	json_add_boolean use_syslog 1
	json_add_boolean ipv6_first "$ipv6_first"
	json_add_boolean fast_open "$fast_open"
	json_add_boolean reuse_port "$reuse_port"
	json_add_boolean no_delay "$no_delay"
	[ -z "$local_address" ] || json_add_string local_address "$local_address"
	[ -z "$local_port" ] || json_add_int local_port "$local_port"
	[ -z "$local_ipv4_address" ] || json_add_string local_ipv4_address "$local_ipv4_address"
	[ -z "$local_ipv6_address" ] || json_add_string local_ipv6_address "$local_ipv6_address"
	[ -z "$mode" ] || json_add_string mode "$mode"
	[ -z "$mtu" ] || json_add_int mtu "$mtu"
	[ -z "$timeout" ] || json_add_int timeout "$timeout"
	[ -z "$user" ] || json_add_string user "$user"
	[ -z "$acl" ] || json_add_string acl "$acl"
	json_dump -i >"$confjson"

	procd_open_instance "$cfgtype.$cfg"
	procd_set_param command "$bin" -c "$confjson"
	[ "$verbose" = 0 ] || procd_append_param command -v
	if [ -n "$bind_address" ]; then
		echo "$cfgtype $cfg: uci option bind_address deprecated, please switch to local_address" >&2
		procd_append_param command -b "$bind_address"
	fi
	procd_set_param file "$confjson"
	procd_set_param respawn
	procd_close_instance
	ss_log "started $cfgtype.$cfg json=$confjson"
	ss_rules_cb
}

ss_rules_cb() {
	local cfgserver server

	if [ "$cfgtype" = ss_redir ]; then
		config_get cfgserver "$cfg" server
		config_get server "$cfgserver" server
		ss_redir_servers="$ss_redir_servers $server"
		if [ "$mode" = tcp_only -o "$mode" = "tcp_and_udp" ]; then
			eval "ss_rules_redir_tcp_$cfg=$local_port"
		fi
		if [ "$mode" = udp_only -o "$mode" = "tcp_and_udp" ]; then
			eval "ss_rules_redir_udp_$cfg=$local_port"
		fi
	fi
}

ss_rules_nft_gen() {
	local cfg="ss_rules"
	local cfgtype
	local local_port_tcp local_port_udp
	local remote_servers

	[ -s "$ssrules_uc" ] || return 1

	config_get cfgtype "$cfg" TYPE
	[ "$cfgtype" = ss_rules ] || return 1

	eval "$(validate_ss_rules_section "$cfg" ss_validate_mklocal)"
	validate_ss_rules_section "$cfg" || { ss_log "nft skip: ss_rules validate fail"; return 1; }
	[ "$disabled" = 0 ] || { ss_log "nft skip: ss_rules disabled"; return 2; }

	eval local_port_tcp="\$ss_rules_redir_tcp_$redir_tcp"
	eval local_port_udp="\$ss_rules_redir_udp_$redir_udp"
	[ -n "$local_port_tcp" -o -n "$local_port_udp" ] || { ss_log "nft skip: no redir port (ss-redir/xray did not start)"; return 1; }
	remote_servers="$(echo $ss_redir_servers | tr ' ' '\n' | sort -u | while read -r h; do
		[ -n "$h" ] || continue
		ss_resolve4 "$h" || echo "$h"
	done | sort -u)"
	ss_log "nft ports tcp=$local_port_tcp udp=$local_port_udp remotes=$remote_servers"

	local tmp="/tmp/ssrules"
	json_init
	json_add_string o_remote_servers "$remote_servers"
	json_add_int o_redir_tcp_port "$local_port_tcp"
	json_add_int o_redir_udp_port "$local_port_udp"
	json_add_string o_ifnames "$ifnames"
	json_add_string o_local_default "$local_default"
	json_add_string o_src_bypass "$src_ips_bypass"
	json_add_string o_src_forward "$src_ips_forward"
	json_add_string o_src_checkdst "$src_ips_checkdst"
	json_add_string o_src_default "$src_default"
	json_add_string o_dst_bypass "$dst_ips_bypass"
	json_add_string o_dst_forward "$dst_ips_forward"
	json_add_string o_dst_bypass_file "$dst_ips_bypass_file"
	json_add_string o_dst_forward_file "$dst_ips_forward_file"
	json_add_string o_dst_default "$dst_default"
	json_add_string o_nft_tcp_extra "$nft_tcp_extra"
	json_add_string o_nft_udp_extra "$nft_udp_extra"
	json_dump -i >"$tmp.json"

	if command -v utpl >/dev/null 2>&1; then
		utpl -S -F "$tmp.json" "$ssrules_uc" >"$tmp.nft" 2>"$tmp.utpl.err" || true
	elif command -v ucode >/dev/null 2>&1; then
		ucode -S -F "$tmp.json" "$ssrules_uc" >"$tmp.nft" 2>"$tmp.utpl.err" || true
	else
		ss_log "nft gen fail: utpl/ucode missing"
		rm -f "$tmp.json"
		return 1
	fi
	if [ ! -s "$tmp.nft" ]; then
		ss_log "nft template empty: $(tr '\n' ' ' <"$tmp.utpl.err" 2>/dev/null)"
		rm -f "$tmp.json" "$tmp.nft" "$tmp.utpl.err"
		return 1
	fi
	if cmp -s "$tmp.nft" "$ssrules_nft"; then
		ss_log "nft rules unchanged"
		rm -f "$tmp.json" "$tmp.nft" "$tmp.utpl.err"
		return 0
	fi
	echo "table inet chk {include \"$tmp.nft\";}" >"$tmp.nft.chk"
	if nft -f "$tmp.nft.chk" -c 2>"$tmp.nft.err"; then
		mv "$tmp.nft" "$ssrules_nft"
		fw4 restart
		ss_log "nft rules installed"
		rm -f "$tmp.json" "$tmp.nft.chk" "$tmp.nft.err" "$tmp.utpl.err"
		return 0
	fi
	ss_log "nft -c fail: $(tr '\n' ' ' <"$tmp.nft.err" 2>/dev/null)"
	rm -f "$tmp.json" "$tmp.nft" "$tmp.nft.chk" "$tmp.nft.err" "$tmp.utpl.err"
	return 1
}

ss_rules_nft_reset() {
	if [ -f "$ssrules_nft" ]; then
		rm -f "$ssrules_nft"
		fw4 restart
	fi
}

ss_rules() {
	if ! ss_rules_nft_gen; then
		ss_log "nft not applied (gen failed or rules disabled), resetting"
		ss_rules_nft_reset
	fi
}

ss_easy_dns() {
	local enabled="$1"
	mkdir -p /tmp/dnsmasq.d
	if [ "$enabled" = 1 ]; then
		printf '%s\n' 'no-resolv' 'server=127.0.0.1#8053' >/tmp/dnsmasq.d/ss-easy.conf
	else
		rm -f /tmp/dnsmasq.d/ss-easy.conf
	fi
	[ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

ss_json_esc() {
	echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

ss_xray_inbounds() {
	cat <<'EOF'
  "inbounds": [
    {"tag": "redir", "port": 1234, "protocol": "dokodemo-door", "settings": {"network": "tcp,udp", "followRedirect": true}, "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}},
    {"tag": "dns", "listen": "127.0.0.1", "port": 8053, "protocol": "dokodemo-door", "settings": {"address": "8.8.8.8", "port": 53, "network": "tcp,udp"}}
  ]
EOF
}

ss_xray_write() {
	local node="$1" kind="$2"
	local host orig port uuid aid net tls path whost security proto users method password ip
	orig=$(uci -q get shadowsocks-libev."$node".server)
	port=$(uci -q get shadowsocks-libev."$node".server_port)
	ip=$(ss_resolve4 "$orig")
	host=${ip:-$orig}
	[ "$host" != "$orig" ] && ss_log "resolved $orig -> $host"
	mkdir -p /var/etc
	if [ "$kind" = ss ]; then
		method=$(uci -q get shadowsocks-libev."$node".method)
		password=$(uci -q get shadowsocks-libev."$node".password)
		[ -n "$method" ] || method=aes-256-gcm
		cat >/var/etc/xray.json <<EOF
{
  "log": {"loglevel": "warning"},
$(ss_xray_inbounds),
  "outbounds": [
    {
      "protocol": "shadowsocks",
      "settings": {
        "servers": [{
          "address": "$(ss_json_esc "$host")",
          "port": ${port:-0},
          "method": "$(ss_json_esc "$method")",
          "password": "$(ss_json_esc "$password")"
        }]
      }
    }
  ]
}
EOF
		return 0
	fi
	uuid=$(uci -q get shadowsocks-libev."$node".uuid)
	[ -n "$uuid" ] || uuid=$(uci -q get shadowsocks-libev."$node".password)
	aid=$(uci -q get shadowsocks-libev."$node".alter_id)
	net=$(uci -q get shadowsocks-libev."$node".network)
	tls=$(uci -q get shadowsocks-libev."$node".tls)
	path=$(uci -q get shadowsocks-libev."$node".ws_path)
	whost=$(uci -q get shadowsocks-libev."$node".ws_host)
	security=$(uci -q get shadowsocks-libev."$node".method)
	proto=$(uci -q get shadowsocks-libev."$node".protocol)
	[ -n "$aid" ] || aid=0
	[ -n "$net" ] || net=tcp
	[ -n "$security" ] || security=auto
	[ "$proto" = vless ] && proto=vless || proto=vmess
	case "$security" in
		aes-128-gcm|aes-256-gcm|chacha20-ietf-poly1305|auto|none) ;;
		*) security=auto ;;
	esac
	if [ "$proto" = vless ]; then
		users="{\"id\": \"$(ss_json_esc "$uuid")\", \"encryption\": \"none\"}"
	else
		users="{\"id\": \"$(ss_json_esc "$uuid")\", \"alterId\": ${aid}, \"security\": \"$(ss_json_esc "$security")\"}"
	fi
	[ -n "$whost" ] || whost=$orig
	cat >/var/etc/xray.json <<EOF
{
  "log": {"loglevel": "warning"},
$(ss_xray_inbounds),
  "outbounds": [
    {
      "protocol": "$proto",
      "settings": {"vnext": [{"address": "$(ss_json_esc "$host")", "port": ${port:-0}, "users": [$users]}]},
      "streamSettings": {
        "network": "$(ss_json_esc "$net")",
        "security": "$([ "$tls" = tls ] && echo tls || echo none)"$([ "$net" = ws ] && printf ',\n        "wsSettings": {"path": "%s", "headers": {"Host": "%s"}}' "$(ss_json_esc "$path")" "$(ss_json_esc "$whost")")$([ "$tls" = tls ] && printf ',\n        "tlsSettings": {"serverName": "%s"}' "$(ss_json_esc "$whost")")
      }
    }
  ]
}
EOF
}

ss_copy_easy_remote() {
	local node="$1"
	local host orig port method password key
	orig=$(uci -q get shadowsocks-libev."$node".server)
	host=$(ss_resolve4 "$orig")
	host=${host:-$orig}
	port=$(uci -q get shadowsocks-libev."$node".server_port)
	method=$(uci -q get shadowsocks-libev."$node".method)
	password=$(uci -q get shadowsocks-libev."$node".password)
	key=$(uci -q get shadowsocks-libev."$node".key)
	uci -q set shadowsocks-libev.easy_remote=server
	uci -q set shadowsocks-libev.easy_remote.disabled=0
	uci -q set shadowsocks-libev.easy_remote.server="$host"
	uci -q set shadowsocks-libev.easy_remote.server_port="$port"
	uci -q set shadowsocks-libev.easy_remote.method="$method"
	uci -q set shadowsocks-libev.easy_remote.password="$password"
	uci -q delete shadowsocks-libev.easy_remote.plugin
	uci -q delete shadowsocks-libev.easy_remote.plugin_opts
	[ -n "$key" ] && uci -q set shadowsocks-libev.easy_remote.key="$key" || uci -q delete shadowsocks-libev.easy_remote.key
}

ss_dns_watch() {
	local n=0
	while [ $n -lt 20 ]; do
		if ss_listening 8053; then
			ss_easy_dns 1
			ss_log "DNS hijack on (8053 is up)"
			/usr/libexec/ss-easy-status.sh >/dev/null 2>&1 || true
			return 0
		fi
		sleep 1
		n=$((n + 1))
	done
	ss_easy_dns 0
	ss_log "8053 never listened; DNS not hijacked (see status)"
	/usr/libexec/ss-easy-status.sh >/dev/null 2>&1 || true
}

ss_easy_sync() {
	local enabled mode node remote on proto typ method plugin
	ss_on_ss=0
	ss_on_xray=0
	enabled=$(uci -q get shadowsocks-libev.easy.enabled)
	[ -n "$enabled" ] || return 0
	mode=$(uci -q get shadowsocks-libev.easy.mode)
	node=$(uci -q get shadowsocks-libev.easy.node)
	[ -z "$node" ] && node=$(uci -q get shadowsocks-libev.easy.server)
	proto=$(uci -q get shadowsocks-libev."$node".protocol)
	[ -n "$proto" ] || proto=ss
	method=$(uci -q get shadowsocks-libev."$node".method)
	plugin=$(uci -q get shadowsocks-libev."$node".plugin)
	[ "$enabled" = 1 ] && [ -n "$node" ] && on=1 || on=0

	uci -q set shadowsocks-libev.sss0.disabled=1
	uci -q set shadowsocks-libev.hi.disabled=1
	uci -q set shadowsocks-libev.hj.disabled=1

	if [ "$on" = 1 ] && [ -n "$plugin" ]; then
		ss_log "ERROR: plugin $plugin is not in this firmware; will not start a fake plain SS"
		on=0
	fi

	if [ "$on" = 1 ]; then
		case "$proto" in
			vmess|vless)
				ss_on_xray=1 ;;
			ss)
				if ss_method_libev_ok "$method"; then
					ss_on_ss=1
				else
					ss_on_xray=1
					ss_log "SS method $method is not libev; use Xray"
				fi
				;;
			*)
				ss_log "ERROR: unknown protocol $proto"
				on=0 ;;
		esac
	fi

	remote=easy_remote
	if [ "$ss_on_ss" = 1 ]; then
		ss_copy_easy_remote "$node"
		remote=easy_remote
		uci -q set shadowsocks-libev."$node".disabled=0
	fi
	ss_log "sync enabled=$enabled on=$on proto=$proto method=$method node=$node ss=$ss_on_ss xray=$ss_on_xray remote=$remote"

	uci -q batch <<-EOF
		set shadowsocks-libev.easy_redir=ss_redir
		set shadowsocks-libev.easy_redir.server='$remote'
		set shadowsocks-libev.easy_redir.local_address='0.0.0.0'
		set shadowsocks-libev.easy_redir.local_port='1234'
		set shadowsocks-libev.easy_redir.mode='tcp_and_udp'
		set shadowsocks-libev.easy_redir.timeout='60'
		set shadowsocks-libev.easy_redir.disabled='$([ "$ss_on_ss" = 1 ] && echo 0 || echo 1)'
		set shadowsocks-libev.easy_dns=ss_tunnel
		set shadowsocks-libev.easy_dns.server='$remote'
		set shadowsocks-libev.easy_dns.local_address='127.0.0.1'
		set shadowsocks-libev.easy_dns.local_port='8053'
		set shadowsocks-libev.easy_dns.tunnel_address='8.8.8.8:53'
		set shadowsocks-libev.easy_dns.mode='tcp_and_udp'
		set shadowsocks-libev.easy_dns.timeout='60'
		set shadowsocks-libev.easy_dns.disabled='$([ "$ss_on_ss" = 1 ] && echo 0 || echo 1)'
		set shadowsocks-libev.ss_rules=ss_rules
		set shadowsocks-libev.ss_rules.redir_tcp='easy_redir'
		set shadowsocks-libev.ss_rules.redir_udp='easy_redir'
		set shadowsocks-libev.ss_rules.ifnames='br-lan'
		set shadowsocks-libev.ss_rules.disabled='$([ "$on" = 1 ] && echo 0 || echo 1)'
	EOF

	rm -f /var/etc/xray.json
	if [ "$ss_on_xray" = 1 ]; then
		if [ "$proto" = ss ]; then
			ss_xray_write "$node" ss
		else
			ss_xray_write "$node" v2
		fi
		if ss_xray_bin >/dev/null; then
			ss_log "xray binary ready"
		else
			on=0
			ss_on_xray=0
			rm -f /var/etc/xray.json
			uci -q set shadowsocks-libev.ss_rules.disabled=1
			ss_fetch_xray_bg
		fi
	fi

	if [ "$mode" = global ]; then
		uci -q batch <<-EOF
			set shadowsocks-libev.ss_rules.src_default='forward'
			set shadowsocks-libev.ss_rules.dst_default='forward'
			set shadowsocks-libev.ss_rules.local_default='forward'
			delete shadowsocks-libev.ss_rules.dst_ips_bypass_file
		EOF
	else
		uci -q batch <<-EOF
			set shadowsocks-libev.ss_rules.src_default='checkdst'
			set shadowsocks-libev.ss_rules.dst_default='forward'
			set shadowsocks-libev.ss_rules.local_default='checkdst'
			set shadowsocks-libev.ss_rules.dst_ips_bypass_file='/usr/share/ss-easy/chnroute.txt'
		EOF
	fi
	uci -q commit shadowsocks-libev
	# Never hijack DNS here: procd has not started ss-tunnel/xray yet.
	ss_easy_want_dns=$on
}

start_service() {
	local cfgtype xray node proto

	mkdir -p "$ss_confdir"
	ss_easy_want_dns=0
	ss_on_xray=0
	ss_easy_sync
	config_load shadowsocks-libev
	for cfgtype in ss_local ss_redir ss_server ss_tunnel; do
		config_foreach ss_xxx "$cfgtype" "$cfgtype"
	done
	node=$(uci -q get shadowsocks-libev.easy.node)
	if [ "$(uci -q get shadowsocks-libev.easy.enabled)" = 1 ] && [ -n "$node" ]; then
		ss_redir_servers="$ss_redir_servers $(uci -q get shadowsocks-libev.$node.server)"
		proto=$(uci -q get shadowsocks-libev.$node.protocol)
		if [ -s /var/etc/xray.json ] && ss_xray_bin >/dev/null; then
			ss_rules_redir_tcp_easy_redir=1234
			ss_rules_redir_udp_easy_redir=1234
		fi
	fi
	ss_rules
	if [ -s /var/etc/xray.json ]; then
		xray=$(ss_xray_bin) || xray=
		if [ -n "$xray" ]; then
			procd_open_instance xray
			procd_set_param command "$xray" run -c /var/etc/xray.json
			procd_set_param file /var/etc/xray.json
			procd_set_param respawn
			procd_close_instance
			ss_log "started xray $xray"
		else
			ss_log "xray json present but binary missing"
		fi
	fi
	if [ "$ss_easy_want_dns" = 1 ]; then
		( ss_dns_watch ) >/dev/null 2>&1 &
	else
		ss_easy_dns 0
	fi
	/usr/libexec/ss-easy-status.sh >/dev/null 2>&1 || true
}

stop_service() {
	ss_rules_nft_reset
	rm -rf "$ss_confdir"
	ss_easy_dns 0
}

service_triggers() {
	procd_add_reload_interface_trigger wan
	procd_add_reload_trigger shadowsocks-libev
	procd_open_validate
	validate_server_section
	validate_ss_local_section
	validate_ss_redir_section
	validate_ss_rules_section
	validate_ss_server_section
	validate_ss_tunnel_section
	procd_close_validate
}

ss_validate_mklocal() {
	local tuple opts

	shift 2
	for tuple in "$@"; do
		opts="${tuple%%:*} $opts"
	done
	[ -z "$opts" ] || echo "local $opts"
}

ss_validate() {
	uci_validate_section shadowsocks-libev "$@"
}

validate_common_server_options_() {
	local cfgtype="$1"; shift
	local cfg="$1"; shift
	local func="$1"; shift
	local stream_methods='"table", "rc4", "rc4-md5", "aes-128-cfb", "aes-192-cfb", "aes-256-cfb", "aes-128-ctr", "aes-192-ctr", "aes-256-ctr", "bf-cfb", "camellia-128-cfb", "camellia-192-cfb", "camellia-256-cfb", "salsa20", "chacha20", "chacha20-ietf"'
	local aead_methods='"aes-128-gcm", "aes-192-gcm", "aes-256-gcm", "chacha20-ietf-poly1305", "xchacha20-ietf-poly1305"'

	"${func:-ss_validate}" "$cfgtype" "$cfg" "$@" \
		'disabled:bool:0' \
		'server:host' \
		'server_port:port' \
		'password:string' \
		'key:string' \
		"method:or($stream_methods, $aead_methods)" \
		'plugin:string' \
		'plugin_opts:string'
}

validate_common_client_options_() {
	validate_common_options_ "$@" \
		'server:uci("shadowsocks-libev", "@server")' \
		'local_address:ipaddr:0.0.0.0' \
		'local_port:port'
}

validate_common_options_() {
	local cfgtype="$1"; shift
	local cfg="$1"; shift
	local func="$1"; shift

	"${func:-ss_validate}" "$cfgtype" "$cfg" "$@" \
		'disabled:bool:0' \
		'fast_open:bool:0' \
		'ipv6_first:bool:0' \
		'no_delay:bool:0' \
		'reuse_port:bool:0' \
		'verbose:bool:0' \
		'mode:or("tcp_only", "udp_only", "tcp_and_udp"):tcp_only' \
		'mtu:uinteger' \
		'timeout:uinteger' \
		'user:string'
}

validate_server_section() {
	validate_common_server_options_ server "$1" "$2"
}

validate_ss_local_section() {
	validate_common_client_options_ ss_local "$1" "$2" \
		'acl:file'
}

validate_ss_redir_section() {
	validate_common_client_options_ ss_redir "$1" "$2"
}

validate_ss_rules_section() {
	"${2:-ss_validate}" ss_rules "$1" \
		'disabled:bool:0' \
		'redir_tcp:uci("shadowsocks-libev", "@ss_redir")' \
		'redir_udp:uci("shadowsocks-libev", "@ss_redir")' \
		'src_ips_bypass:or(ipaddr,cidr)' \
		'src_ips_forward:or(ipaddr,cidr)' \
		'src_ips_checkdst:or(ipaddr,cidr)' \
		'dst_ips_bypass_file:file' \
		'dst_ips_bypass:or(ipaddr,cidr)' \
		'dst_ips_forward_file:file' \
		'dst_ips_forward:or(ipaddr,cidr)' \
		'src_default:or("bypass", "forward", "checkdst"):checkdst' \
		'dst_default:or("bypass", "forward"):bypass' \
		'local_default:or("bypass", "forward", "checkdst"):bypass' \
		'nft_tcp_extra:string' \
		'nft_udp_extra:string' \
		'ifnames:maxlength(15)'
}

validate_ss_server_section() {
	validate_common_server_options_ ss_server "$1" \
		validate_common_options_ \
		"$2" \
		'local_address:ipaddr' \
		'local_ipv4_address:ip4addr' \
		'local_ipv6_address:ip6addr' \
		'bind_address:ipaddr' \
		'acl:file'
}

validate_ss_tunnel_section() {
	validate_common_client_options_ ss_tunnel "$1" \
		"$2" \
		'tunnel_address:regex(".+\:[0-9]+")'
}
