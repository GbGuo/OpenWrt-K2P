{
	"luci-app-shadowsocks-libev": {
		"description": "Grant service list access to LuCI app shadowsocks-libev",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"file": [ "read" ]
			},
			"uci": [ "shadowsocks-libev" ],
			"file": {
				"/tmp/ss-easy-probe.txt": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "read", "write", "exec", "stat" ]
			},
			"file": {
				"/etc/shadowsocks-libev/*": [ "write" ],
				"/etc/init.d/shadowsocks-libev": [ "exec" ],
				"/usr/libexec/ss-official-up.sh": [ "exec" ],
				"/usr/libexec/ss-easy-probe.sh": [ "exec" ],
				"/usr/libexec/xray-easy-up.sh": [ "exec" ],
				"/tmp/xray-config.json": [ "write" ],
				"/tmp/ss-easy-probe.txt": [ "read" ]
			},
			"uci": [ "shadowsocks-libev" ]
		}
	}
}
